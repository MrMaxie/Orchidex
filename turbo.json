{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "noUpdateNotifier": true,
  "globalDependencies": ["Cargo.toml", "Cargo.lock"],
  "remoteCache": {
    "enabled": false
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "check": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "cli": {
      "cache": false
    }
  }
}

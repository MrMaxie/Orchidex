{
  "name": "orchidex-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "web",
    "tauri"
  ],
  "scripts": {
    "dev": "bun run --cwd web dev",
    "build": "bun run --cwd web build",
    "preview": "bun run --cwd web preview",
    "core": "cargo run -p orchidex-core --",
    "core:serve": "cargo run -p orchidex-core -- serve",
    "tauri": "bun run --cwd tauri tauri"
  }
}
